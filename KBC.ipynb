# 🎉 Kaun Banega Crorepati (KBC) Game 🎉

questions = [
    {
        "question": "Which is the capital of India?",
        "options": ["A. Mumbai", "B. Delhi", "C. Kolkata", "D. Chennai"],
        "answer": "B"
    },
    {
        "question": "Who is known as the father of computers?",
        "options": ["A. Charles Babbage", "B. Alan Turing", "C. Bill Gates", "D. Steve Jobs"],
        "answer": "A"
    },
    {
        "question": "Which is the largest planet in our solar system?",
        "options": ["A. Earth", "B. Mars", "C. Jupiter", "D. Saturn"],
        "answer": "C"
    },
    {
        "question": "Which programming language is known as the backbone of web development?",
        "options": ["A. C++", "B. Python", "C. JavaScript", "D. Java"],
        "answer": "C"
    },
    {
        "question": "Who wrote the Ramayana?",
        "options": ["A. Tulsidas", "B. Valmiki", "C. Ved Vyasa", "D. Kalidas"],
        "answer": "B"
    }
]

prizes = [1000, 2000, 5000, 10000, 20000]

def kbc_game():
    print("🎉 Welcome to Kaun Banega Crorepati (KBC) 🎉")
    print("Answer the questions correctly to win money!\n")
    winnings = 0

    for i, q in enumerate(questions):
        print(f"\nQuestion {i+1} for ₹{prizes[i]}:")
        print(q["question"])
        for opt in q["options"]:
            print(opt)

        ans = input("Your answer (A/B/C/D): ").strip().upper()

        if ans == q["answer"]:
            winnings = prizes[i]
            print(f"✅ Correct! You have won ₹{winnings}")
        else:
            print(f"❌ Wrong answer! The correct answer was {q['answer']}.")
            break

    print("\n💰 You take home ₹", winnings)


# Run the game
kbc_game()
